{
  "port": 4200,
  "jiraSite": "https://performyard.atlassian.net",
  "jiraEmail": "you@performyard.com",
  "jiraToken": "PASTE_TOKEN_FROM_id.atlassian.com",
  "jiraProject": "PY",
  "docsDir": "/Users/YOU/Work/docs",
  "editor": "Cursor",
  "notifications": true,
  "jiraSprintField": "customfield_10020",
  "myAccountId": "RUN: work-dash whoami",
  "repos": {
    "PerformYard/PerformYard": {
      "docsSubdir": "PY",
      "slots": [
        "/Users/YOU/Work/PY-1",
        "/Users/YOU/Work/PY-2",
        "/Users/YOU/Work/PY-3"
      ]
    },
    "PerformYard/Logan": {
      "docsSubdir": "Logan",
      "slots": [
        "/Users/YOU/Work/Logan",
        "/Users/YOU/Work/Logan2",
        "/Users/YOU/Work/Logan3"
      ]
    }
  },
  "inFlightStatusOrder": [
    "In Progress",
    "In Code Review",
    "Ready To Test",
    "In Testing",
    "Ready To Merge"
  ],
  "skills": [
    {
      "name": "ticket-planner",
      "when": "!branch && !pr"
    },
    {
      "name": "engineering-subtasking",
      "when": "!branch && !pr"
    },
    {
      "name": "critical-review",
      "when": "slot"
    },
    {
      "name": "react-doctor",
      "when": "slot"
    },
    {
      "name": "resolve-code-review",
      "when": "pr.hasReviewComments || pr.changesRequested"
    },
    {
      "name": "pr-description",
      "when": "pr"
    },
    {
      "name": "ticket-finisher",
      "when": "pr"
    },
    {
      "name": "toggle-logan-env",
      "when": "repo == 'PerformYard/Logan'"
    }
  ],
  "githubLogin": "RUN: work-dash whoami"
}